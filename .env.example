# SchoolConnect Environment Variables

# Application Configuration
VITE_APP_NAME=SchoolConnect
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Plateforme de gestion scolaire pour la RDC"

# API Configuration (for future backend integration)
# VITE_API_BASE_URL=https://api.schoolconnect.cd
# VITE_API_VERSION=v1

# Authentication (for future integration)
# VITE_AUTH_DOMAIN=schoolconnect.auth0.com
# VITE_AUTH_CLIENT_ID=your_auth0_client_id

# Analytics (for future integration)
# VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# VITE_HOTJAR_ID=your_hotjar_id

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT_SUPPORT=false
VITE_MAINTENANCE_MODE=false

# Deployment Environment
VITE_ENVIRONMENT=production
VITE_BUILD_DATE=2024-01-01
